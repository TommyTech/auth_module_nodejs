{
  "name": "@digipolis/auth",
  "version": "2.5.0",
  "description": "",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "rollup -c --exports default",
    "prepublish": "npm run build",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test": "c8 node --import ./scripts/register-esm-loader.js ./node_modules/mocha/bin/mocha.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digipolisantwerp/auth_module_nodejs.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "async": "~3.2.4",
    "bcryptjs": "~2.4.3",
    "cookie": "~0.7.2",
    "express": "~4.22.3",
    "isomorphic-fetch": "~3.0.0",
    "lodash.get": "~4.4.2",
    "oauth": "~0.10.0",
    "pino": "~8.8.0",
    "uuid": "~11.1.1"
  },
  "overrides": {
    "cookie": "$cookie",
    "send": "^0.19.0",
    "serve-static": "^1.16.0",
    "body-parser": "^1.20.6",
    "qs": "^6.14.2",
    "express": {
      "path-to-regexp": "0.1.13"
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "~24.0.1",
    "@rollup/plugin-node-resolve": "~15.0.1",
    "c8": "~10.1.3",
    "eslint": "~8.33.0",
    "eslint-config-airbnb-base": "~15.0.0",
    "eslint-plugin-import": "~2.27.5",
    "mocha": "~10.2.0",
    "nock": "~13.3.0",
    "reqres": "~3.0.1",
    "rollup": "~3.29.4"
  },
  "c8": {
    "include": [
      "src/**"
    ],
    "reporter": [
      "lcov",
      "text"
    ]
  },
  "mocha": {
    "spec": "test/*.js"
  }
}
